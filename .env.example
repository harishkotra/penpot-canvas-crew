# --- Penpot MCP ---------------------------------------------------------
# Running on the SAME machine as Penpot, use localhost. Replace the token with
# your own key: in Penpot go to Your account -> Integrations -> MCP Server,
# which shows this URL with your key already appended.
PENPOT_MCP_URL=http://localhost:9001/mcp/stream?userToken=PASTE_YOUR_MCP_KEY

# If you run the crew on a different machine on the LAN, use that host instead:
# PENPOT_MCP_URL=http://192.168.68.59:9001/mcp/stream?userToken=PASTE_YOUR_MCP_KEY

# --- Inference ----------------------------------------------------------
# Any OpenAI-compatible endpoint. Particle.ai is the default.
PARTICLE_BASE_URL=https://api.particle.ai/v1
PARTICLE_API_KEY=PASTE_YOUR_KEY

# Fully local instead? Point at LM Studio or Ollama and pick a vision model
# for the critic:
#   PARTICLE_BASE_URL=http://127.0.0.1:1234/v1
#   PARTICLE_API_KEY=lm-studio
#   PARTICLE_BASE_URL=http://127.0.0.1:11434/v1
#   PARTICLE_API_KEY=ollama

# --- Model routing ------------------------------------------------------
# Each role can use a different model. Measured on a Particle key:
#   glm5.3flash         tools=yes vision=yes json=yes  (consistent)
#   deepseek-v4.1-flash tools=yes vision=intermittent  json=yes
# The critic needs vision, so it is routed to the consistent model.
CREW_PLANNER_MODEL=glm5.3flash
CREW_BUILDER_MODEL=deepseek-v4.1-flash
CREW_CRITIC_MODEL=glm5.3flash
CREW_ARBITER_MODEL=glm5.3flash

# --- Loop ---------------------------------------------------------------
CREW_MAX_ROUNDS=3
CREW_PASS_SCORE=8
CREW_BOARD_NAME=Crew
CREW_TIMEOUT_MS=180000

# --- Connection retry ---------------------------------------------------
# The Penpot plugin drops whenever its tab is hidden, which is what happens
# when you launch the crew from a terminal on the same machine. These control
# how long the crew waits for you to click back into the Penpot tab.
# Defaults: 6 attempts, 5s apart, roughly 75 seconds total.
CREW_RETRY_ATTEMPTS=6
CREW_RETRY_DELAY_MS=5000

# --- Token budgets per role ---------------------------------------------
# These are deliberately large. On endpoints that serve reasoning models, the
# reasoning tokens are drawn from the SAME budget as the answer, so a small
# budget can return an empty response. A 7-section spec made the builder spend
# 16000 tokens thinking and return zero characters of code at a 4000 budget.
# If a run fails with "returned no code", raise CREW_BUILDER_MAX_TOKENS.
CREW_PLANNER_MAX_TOKENS=8000
CREW_BUILDER_MAX_TOKENS=16000
CREW_CRITIC_MAX_TOKENS=4000
CREW_ARBITER_MAX_TOKENS=1200